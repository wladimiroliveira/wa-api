// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`routes inventory > matches the recorded access of every route 1`] = `
"DELETE /v1/roles/:id -> ACCESS_UPDATE
GET /v1/health -> public
GET /v1/roles -> ACCESS_READ
GET /v1/sessions/me -> authenticated
HEAD /v1/health -> public
HEAD /v1/roles -> ACCESS_READ
HEAD /v1/sessions/me -> authenticated
PATCH /v1/roles/:id -> ACCESS_UPDATE
POST /v1/roles -> ACCESS_CREATE
POST /v1/sessions/refresh -> public
POST /v1/sessions/signin -> public
POST /v1/sessions/signout -> authenticated"
`;
