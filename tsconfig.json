{
  "$schema": "https://www.schemastore.org/tsconfig",
  "display": "Node 22",
  "_version": "22.0.0",

  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
    "moduleResolution": "node16",
    "module": "nodenext",
    "target": "es2022",
    "strict": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*", "./src/generated/**/*", "./scripts/**/*", "./tests/**/*"]
}
