# =============================================================================
# HTTP server
# =============================================================================

# Port the API binds to
API_PORT=3333

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string used by Prisma, matching docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wa_api?schema=public"

# =============================================================================
# Authentication — required, the server refuses to start without these
# =============================================================================

# Access token signing key, at least 32 characters
JWT_SECRET="troque-por-um-segredo-de-32-caracteres-ou-mais"

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"

# =============================================================================
# Tokens and rate limiting — optional, the defaults are shown below
# =============================================================================

# How long an access token stays valid
ACCESS_TOKEN_TTL="15m"

# How long a refresh token stays valid, in days
REFRESH_TOKEN_TTL_DAYS=30

# Login attempts allowed per address every 15 minutes
LOGIN_RATE_LIMIT_MAX=5

# =============================================================================
# First user — read only by `npm run db:seed`
# =============================================================================

# Login credential of the user that owns every permission
OWNER_USERNAME="dono"

# Email address of that first user
OWNER_EMAIL="dono@example.com"

# Password of that first user
OWNER_PASSWORD="troque-esta-senha"
