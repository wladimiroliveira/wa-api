# =============================================================================
# HTTP server
# =============================================================================

# Port the API binds to
API_PORT=3333

# =============================================================================
# Database — docker-compose.yml reads these too, so both sides never drift
# =============================================================================
# The container only reads the role, password and database name while the data
# volume is empty. Changing them afterwards does not rename anything: drop the
# volume with `npm run services:down -- --volumes` first.

# Role the container is created with and the API connects as
POSTGRES_USER="postgres"

# Password of that role
POSTGRES_PASSWORD="postgres"

# Database created on the first boot
POSTGRES_DB="wa_api"

# Host the API reaches PostgreSQL at
POSTGRES_HOST="localhost"

# Port the container publishes on the host
POSTGRES_PORT=5432

# Connection string assembled from the values above — Prisma reads only this one
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# =============================================================================
# Authentication — required, the server refuses to start without these
# =============================================================================

# Access token signing key, at least 32 characters
JWT_SECRET="troque-por-um-segredo-de-32-caracteres-ou-mais"

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS="http://localhost:5173"

# =============================================================================
# Tokens and rate limiting — optional, the defaults are shown below
# =============================================================================

# How long an access token stays valid
ACCESS_TOKEN_TTL="15m"

# How long a refresh token stays valid, in days
REFRESH_TOKEN_TTL_DAYS=30

# Login attempts allowed per address every 15 minutes
LOGIN_RATE_LIMIT_MAX=5

# =============================================================================
# First user — read only by `npm run db:seed`
# =============================================================================

# Login credential of the user that owns every permission
OWNER_USERNAME="dono"

# Email address of that first user
OWNER_EMAIL="dono@example.com"

# Password of that first user
OWNER_PASSWORD="troque-esta-senha"
