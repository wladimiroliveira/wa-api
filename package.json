{
  "name": "wa-api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:prisma-client",
    "build:prisma-client": "node --input-type=commonjs --eval \"require('node:fs').cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "start": "node ./dist/server.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "prepare": "husky",
    "commit": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "dev:full": "npm run services:up && npm run db:migrate && npm run db:seed && npm run dev"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.5",
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "dotenv-expand": "1000.0.0",
    "fastify": "5.8.5",
    "fastify-type-provider-zod": "6.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "commitizen": "4.3.1",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "vitest": "4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
